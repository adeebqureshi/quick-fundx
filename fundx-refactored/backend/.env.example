# Server
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Database (async URL for app; Alembic uses sync URL below)
DATABASE_URL=postgresql+asyncpg://qfx_user:qfx_dev_pass@localhost:5432/quickfundx_dev
# Optional: sync URL for Alembic if different from async (postgresql://...)
# DATABASE_URL_SYNC=postgresql://qfx_user:qfx_dev_pass@localhost:5432/quickfundx_dev

# Redis (Celery broker + cache + rate limit backend)
REDIS_URL=redis://:redis_dev_pass@localhost:6379/0

# JWT — generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_ACCESS_SECRET=replace_with_64_char_hex_minimum_32_chars_secret
JWT_REFRESH_SECRET=replace_with_different_64_char_hex_secret_key_here
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional integrations (omit for mock mode)
MSG91_AUTHKEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_KYC=
# Local KYC storage when S3 not configured
KYC_LOCAL_STORAGE_PATH=./data/kyc_uploads

# Rate limits (per minute)
RATE_LIMIT_PUBLIC=100
RATE_LIMIT_AUTH=500
RATE_LIMIT_ADMIN=2000

# Pytest / local without Celery broker (direct OTP log + sync KYC task stubs)
TESTING=false
